<Window x:Class="MCServerManagerPP.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında" Height="380" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <StackPanel Margin="20" VerticalAlignment="Center">

        <Image Source="pack://application:,,,/icon.png" Width="64" Height="64" Margin="0,0,0,10"/>

        <TextBlock Text="MCServerManager++" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <TextBlock x:Name="LblVersion" HorizontalAlignment="Center" 
                   Foreground="Gray" Margin="0,0,0,15"/>

        <TextBlock x:Name="LblDescription" TextWrapping="Wrap" 
                   TextAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock x:Name="LblDevelopedBy" HorizontalAlignment="Center" 
                   FontWeight="Bold" Margin="0,0,0,5"/>

        <TextBlock Text="MyBetaSoft" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock x:Name="LnkGithub" Text="GitHub" HorizontalAlignment="Center" 
                   Foreground="Blue" TextDecorations="Underline" Cursor="Hand"
                   MouseLeftButtonDown="LnkGithub_Click"/>

    </StackPanel>
</Window>