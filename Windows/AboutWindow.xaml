<Window x:Class="MCServerManagerPP.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hakkında" Height="400" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="24" VerticalAlignment="Center">

        <Image Source="pack://application:,,,/icon.png" Width="64" Height="64" Margin="0,0,0,14"/>

        <TextBlock Text="MCServerManager++" FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="Bold" 
                   Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

        <TextBlock x:Name="LblVersion" FontFamily="{StaticResource FontMono}" FontSize="12" 
                   HorizontalAlignment="Center" Foreground="{StaticResource BrushTextFaint}" Margin="0,0,0,18"/>

        <TextBlock x:Name="LblDescription" TextWrapping="Wrap" FontSize="13" 
                   TextAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,18"/>

        <TextBlock x:Name="LblDevelopedBy" FontFamily="{StaticResource FontMono}" 
                   HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource BrushGreenBright}" Margin="0,0,0,4"/>

        <TextBlock Text="MyBetaSoft" HorizontalAlignment="Center" Foreground="{StaticResource BrushText}" Margin="0,0,0,18"/>

        <TextBlock x:Name="LnkGithub" HorizontalAlignment="Center" 
                   Foreground="{StaticResource BrushGreenBright}" TextDecorations="Underline" Cursor="Hand"
                   FontFamily="{StaticResource FontMono}" FontSize="12.5"
                   MouseLeftButtonDown="LnkGithub_Click"/>

    </StackPanel>
</Window>