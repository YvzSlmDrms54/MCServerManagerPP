<Window x:Class="MCServerManagerPP.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bakım Modu" Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="24" VerticalAlignment="Center">

        <TextBlock x:Name="LblStatus" FontFamily="{StaticResource FontMono}" FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TextBlock x:Name="LblDescription" TextWrapping="Wrap" FontSize="13" 
                   TextAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,22"/>

        <Button x:Name="BtnToggle" Height="38" Style="{StaticResource BtnPrimary}" Click="BtnToggle_Click"/>

    </StackPanel>
</Window>