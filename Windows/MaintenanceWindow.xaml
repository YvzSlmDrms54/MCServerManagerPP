<Window x:Class="MCServerManagerPP.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bakım Modu" Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <StackPanel Margin="20" VerticalAlignment="Center">

        <TextBlock x:Name="LblStatus" FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock x:Name="LblDescription" TextWrapping="Wrap" 
                   TextAlignment="Center" Foreground="Gray" Margin="0,0,0,20"/>

        <Button x:Name="BtnToggle" Height="40" Click="BtnToggle_Click"/>

    </StackPanel>
</Window>