<Window x:Class="MCServerManagerPP.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yedekleme" Height="520" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="20">

        <TextBlock x:Name="LblAutoBackupHour" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" 
                   FontSize="14" Foreground="{StaticResource BrushGreenBright}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="ComboBackupHour" Width="60" Style="{StaticResource ThemedComboBox}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="6,0,6,0"/>
            <ComboBox x:Name="ComboBackupMinute" Width="60" Style="{StaticResource ThemedComboBox}"/>
            <CheckBox x:Name="ChkBackupEnabled" Style="{StaticResource ThemedCheckBox}" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="True"/>
        </StackPanel>

        <Button x:Name="BtnApply" Height="34" Style="{StaticResource BtnPrimary}" Click="BtnApply_Click" Margin="0,4,0,14"/>
        <Button x:Name="BtnBackupNow" Height="34" Style="{StaticResource BtnGhost}" Click="BtnBackupNow_Click" Margin="0,0,0,18"/>

        <TextBlock x:Name="LastBackupText" FontStyle="Italic" Foreground="{StaticResource BrushTextDim}" Margin="0,0,0,18"/>

        <TextBlock x:Name="LblBackupHistory" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" 
                   FontSize="14" Foreground="{StaticResource BrushGreenBright}" Margin="0,0,0,10"/>
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" 
                BorderThickness="1" CornerRadius="6">
            <ListBox x:Name="BackupListBox" Height="220" Style="{StaticResource ThemedListBox}" BorderThickness="0" Background="Transparent"/>
        </Border>

    </StackPanel>
</Window>