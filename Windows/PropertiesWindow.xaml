<Window x:Class="MCServerManagerPP.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server Properties" Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}">
    <Window.Resources>
        <Style x:Key="ThemedCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{StaticResource BrushSurface}" 
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="14,8" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface2}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushGreenBright}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource BrushTextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <Button x:Name="BtnSave" Height="36" DockPanel.Dock="Bottom" Style="{StaticResource BtnPrimary}" 
                Margin="0,14,0,0" Click="BtnSave_Click"/>

        <TabControl x:Name="TabsRoot" Background="Transparent" BorderThickness="0">

            <TabItem x:Name="TabGeneral" Header="Genel">
                <Border Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblMotd" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="TxtMotd" Width="270" Style="{StaticResource ThemedTextBox}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="motd" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblMaxPlayers" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtMaxPlayers" Width="60" Style="{StaticResource ThemedTextBox}" Text="20"/>
                                        <Button Content="-" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnMaxPlayersDown_Click"/>
                                        <Button Content="+" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnMaxPlayersUp_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="max-players" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblOnlineMode" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleOnlineMode" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="online-mode" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblWhitelist" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleWhitelist" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="white-list" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="TabGamerules" Header="Oyun Kuralları">
                <Border Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="2">

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblGamemode" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ComboGamemode" Width="150" Style="{StaticResource ThemedComboBox}" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="survival"/>
                                        <ComboBoxItem Content="creative"/>
                                        <ComboBoxItem Content="adventure"/>
                                        <ComboBoxItem Content="spectator"/>
                                    </ComboBox>
                                    <TextBlock Text="gamemode" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblDifficulty" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ComboBox x:Name="ComboDifficulty" Width="150" Style="{StaticResource ThemedComboBox}" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="peaceful"/>
                                        <ComboBoxItem Content="easy"/>
                                        <ComboBoxItem Content="normal"/>
                                        <ComboBoxItem Content="hard"/>
                                    </ComboBox>
                                    <TextBlock Text="difficulty" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblPvp" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="TogglePvp" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="pvp" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblHardcore" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleHardcore" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="hardcore" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpawnMonsters" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleSpawnMonsters" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="spawn-monsters" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblAllowFlight" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleAllowFlight" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="allow-flight" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="LblForceGamemode" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ToggleButton x:Name="ToggleForceGamemode" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="force-gamemode" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="TabPerformance" Header="Performans">
                <Border Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblViewDistance" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtViewDistance" Width="60" Style="{StaticResource ThemedTextBox}" Text="10"/>
                                        <Button Content="-" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnViewDistanceDown_Click"/>
                                        <Button Content="+" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnViewDistanceUp_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="view-distance" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblSimDistance" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtSimDistance" Width="60" Style="{StaticResource ThemedTextBox}" Text="10"/>
                                        <Button Content="-" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnSimDistanceDown_Click"/>
                                        <Button Content="+" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnSimDistanceUp_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="simulation-distance" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblSpawnProtection" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtSpawnProtection" Width="60" Style="{StaticResource ThemedTextBox}" Text="0"/>
                                        <Button Content="-" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnSpawnProtectionDown_Click"/>
                                        <Button Content="+" Width="30" Style="{StaticResource BtnGhost}" Padding="0" Margin="6,0,0,0" Click="BtnSpawnProtectionUp_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="spawn-protection" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem x:Name="TabSecurity" Header="Güvenlik">
                <Border Background="{StaticResource BrushSurface2}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblCommandBlock" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8"/>
                                    <ToggleButton x:Name="ToggleCommandBlock" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="enable-command-block" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblRequireResourcePack" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ToggleButton x:Name="ToggleRequireResourcePack" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="require-resource-pack" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblEnforceSecureProfile" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ToggleButton x:Name="ToggleEnforceSecureProfile" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="enforce-secure-profile" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemedCardStyle}" Width="310">
                                <StackPanel>
                                    <TextBlock x:Name="LblPreventProxy" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ToggleButton x:Name="TogglePreventProxy" Style="{StaticResource ThemedToggle}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="prevent-proxy-connections" Foreground="{StaticResource BrushTextFaint}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                        </WrapPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>