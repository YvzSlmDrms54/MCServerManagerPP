<Window x:Class="MCServerManagerPP.WebhookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webhooklar" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="LblAddNew" Text="Yeni Webhook Ekle" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock x:Name="LblName" Text="İsim" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtWebhookName" Margin="0,0,0,8"/>

            <TextBlock x:Name="LblUrl" Text="URL" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtWebhookUrl" Margin="0,0,0,5"/>

            <TextBlock x:Name="LblMention" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtMention" Margin="0,0,0,8"/>

            <UniformGrid Columns="2" Margin="0,5,0,5">
                <CheckBox x:Name="ChkStart" Margin="0,3"/>
                <CheckBox x:Name="ChkStop" Margin="0,3"/>
                <CheckBox x:Name="ChkJoin" Margin="0,3"/>
                <CheckBox x:Name="ChkLeave" Margin="0,3"/>
                <CheckBox x:Name="ChkBackup" Margin="0,3"/>
                <CheckBox x:Name="ChkMaintenance" Margin="0,3"/>
                <CheckBox x:Name="ChkCrash" Margin="0,3"/>
            </UniformGrid>

            <Button x:Name="BtnAddWebhook" Height="30" Margin="0,8,0,0" Click="BtnAddWebhook_Click"/>
        </StackPanel>

        <Button x:Name="BtnDeleteWebhook" Height="30" DockPanel.Dock="Bottom" Margin="0,10,0,0" Click="BtnDeleteWebhook_Click"/>

        <TextBlock x:Name="LblRegistered" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,10,0,8"/>

        <ListBox x:Name="WebhookListBox" DockPanel.Dock="Top" Height="180"/>

    </DockPanel>
</Window>