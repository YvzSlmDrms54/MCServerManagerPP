<Window x:Class="MCServerManagerPP.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamanlanmış Görevler" Height="420" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <StackPanel Margin="20">

        <TextBlock x:Name="LblRestartHeader" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock x:Name="LblRestartTime" VerticalAlignment="Center" Width="70"/>
            <ComboBox x:Name="ComboRestartHour" Width="55"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <ComboBox x:Name="ComboRestartMinute" Width="55"/>
        </StackPanel>
        <CheckBox x:Name="ChkRestartEnabled" Margin="0,5,0,10"/>
        <Button x:Name="BtnApplyRestart" Height="30" Click="BtnApplyRestart_Click" Margin="0,0,0,25"/>

        <Separator Margin="0,0,0,20"/>

        <TextBlock x:Name="LblMaintenanceHeader" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock x:Name="LblMaintenanceStart" VerticalAlignment="Center" Width="70"/>
            <ComboBox x:Name="ComboMaintStartHour" Width="55"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <ComboBox x:Name="ComboMaintStartMinute" Width="55"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
            <TextBlock x:Name="LblMaintenanceEnd" VerticalAlignment="Center" Width="70"/>
            <ComboBox x:Name="ComboMaintEndHour" Width="55"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0,4,0"/>
            <ComboBox x:Name="ComboMaintEndMinute" Width="55"/>
        </StackPanel>
        <CheckBox x:Name="ChkMaintenanceEnabled" Margin="0,5,0,10"/>
        <Button x:Name="BtnApplyMaintenance" Height="30" Click="BtnApplyMaintenance_Click"/>

    </StackPanel>
</Window>