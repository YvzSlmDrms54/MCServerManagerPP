<Window x:Class="MCServerManagerPP.ScheduledTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamanlanmış Görevler" Height="460" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}">
    <StackPanel Margin="22">

        <TextBlock x:Name="LblRestartHeader" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" 
                   FontSize="14" Foreground="{StaticResource BrushGreenBright}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="LblRestartTime" VerticalAlignment="Center" Width="70" Foreground="{StaticResource BrushTextDim}"/>
            <ComboBox x:Name="ComboRestartHour" Width="60" Style="{StaticResource ThemedComboBox}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="6,0,6,0"/>
            <ComboBox x:Name="ComboRestartMinute" Width="60" Style="{StaticResource ThemedComboBox}"/>
        </StackPanel>
        <CheckBox x:Name="ChkRestartEnabled" Style="{StaticResource ThemedCheckBox}" Margin="0,6,0,12"/>
        <Button x:Name="BtnApplyRestart" Height="34" Style="{StaticResource BtnPrimary}" Click="BtnApplyRestart_Click" Margin="0,0,0,26"/>

        <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,0,0,24"/>

        <TextBlock x:Name="LblMaintenanceHeader" FontFamily="{StaticResource FontMono}" FontWeight="SemiBold" 
                   FontSize="14" Foreground="{StaticResource BrushGreenBright}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="LblMaintenanceStart" VerticalAlignment="Center" Width="70" Foreground="{StaticResource BrushTextDim}"/>
            <ComboBox x:Name="ComboMaintStartHour" Width="60" Style="{StaticResource ThemedComboBox}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="6,0,6,0"/>
            <ComboBox x:Name="ComboMaintStartMinute" Width="60" Style="{StaticResource ThemedComboBox}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock x:Name="LblMaintenanceEnd" VerticalAlignment="Center" Width="70" Foreground="{StaticResource BrushTextDim}"/>
            <ComboBox x:Name="ComboMaintEndHour" Width="60" Style="{StaticResource ThemedComboBox}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Foreground="{StaticResource BrushTextDim}" Margin="6,0,6,0"/>
            <ComboBox x:Name="ComboMaintEndMinute" Width="60" Style="{StaticResource ThemedComboBox}"/>
        </StackPanel>
        <CheckBox x:Name="ChkMaintenanceEnabled" Style="{StaticResource ThemedCheckBox}" Margin="0,6,0,12"/>
        <Button x:Name="BtnApplyMaintenance" Height="34" Style="{StaticResource BtnPrimary}" Click="BtnApplyMaintenance_Click"/>

    </StackPanel>
</Window>